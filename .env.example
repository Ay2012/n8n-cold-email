# Copy this file to .env and keep .env out of GitHub.
# Never commit real API keys, OAuth secrets, tokens, or private credentials.

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

OPENAI_API_KEY=replace-with-your-key
GOOGLE_CLIENT_ID=replace-in-n8n-ui-not-here
GOOGLE_CLIENT_SECRET=replace-in-n8n-ui-not-here

TZ=UTC
GENERIC_TIMEZONE=UTC
